    padding: 0 0 5px 0;
    font: normal 120% arial, sans-serif;
    color: #A4AA04;
}
h5,
h6 {
    font: italic 95% arial, sans-serif;
    padding: 0 0 15px 0;
    color: #000;
}
h6 {
    color: #362C20;
}
a,
a:hover{
    outline: none;
    text-decoration: none;
    color: #2e63ff;

}
a:hover ,.button:hover{
    text-decoration: none;
    opacity: 0.5;
}
#logout a {
    color: #fff;
}
.button:hover{
    color: #fff;
}
#main,
#logo,
#menubar,
#site_content,
