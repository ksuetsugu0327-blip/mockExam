}

.text_right{
    text-align: right;
}

.text_center{
    text-align: center;
}
/*********チェックボックス**********/
/* css checkbox01 */
.checkbox{
    display: none;
}
.ctext{
    padding-left: 2em;
    position:relative;
    margin-right: 2em;
}
.ctext::before{
    content: "";
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border: 1px solid #999;
    border-radius: 4px;
    background-color: #fff;
}
.checkbox:checked + .ctext{
    color: #009a9a;
}
.checkbox:checked + .ctext::after{
    content: "";
    display: block;
    position: absolute;
    top: -5px;
    left: 5px;
    width: 7px;
    height: 14px;
    transform: rotate(40deg);
    border-bottom: 3px solid #009a9a;
    border-right: 3px solid #009a9a;
}
#sm_correction .ctext{
    padding: 0;
    margin:0;
    padding-left: 2em;
    position:relative;
    margin-right: 2em;
}
#sm_correction .ctext::before{
    content: "";
    display: block;
    position: absolute;
    top: 0;
    right: auto;
    left: 0;

    border: 1px solid #999;
    border-radius: 4px;
}

