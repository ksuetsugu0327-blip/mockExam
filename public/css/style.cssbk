    padding: 10px;
    margin: 0px 50px 0px 0px;
}
div#menubar {
    padding: 20px 0;
    height: 61px;
    width: 1024px;
    margin: auto;
    background: #29415D;
}
#menubar h2,#menubar p,#menubar a{
    letter-spacing: 0.1em;
    display: block;
    float: left;
    padding: 0 20px;
    text-align: center;
    color: #FFF;
}
#menubar a{
    float: right;
}
#site_content {
    margin: auto;
    width: 1027px;
    min-height: 500px;
    background-color: #fff;
    padding: 1px;
}
#content {
    margin: 2em auto;
    width: 600px;
}

#content_down_width {
    margin: 0em 0em 0em 16em;
    width: 800px;
}
.content {
    margin: 2em auto;
    width: 600px;
    text-align: center;
}
#content_touroku{
    margin: 2em auto;
    width: 463px;
    text-align: center;
}

#content_width{
    margin: 2em auto;
    width: 900px;
    text-align: left;
}

.jm_touroku{

}
