
/***WEBアイコン****/
.top_menu .result-glyph .center {
    height: 64px;
    line-height: 64px;
    text-align: center;
    background-color: #fff;
    color: #000;
    font-size: 24px;
}

.top_menu .the-icons {
  font-size: 120px;
  line-height: 1em;
}
.top_menu .switch {
  position: absolute;
  right: 0;
  bottom: 10px;
  color: #000;
}
.top_menu .codesOn .i-name {
  display: none;
}
.top_menu .codesOn .i-code {
  display: inline;
}     
    .top_menu .icons
    {
      font-family: "fontello";
      font-style: normal;
      font-weight: normal;
      speak: none;
      text-decoration: inherit;
      width: 1em;
      color: #c7c7c7;
      text-align: center;
      /* opacity: .8; */
     
      /* For safety - reset parent styles, that can break glyph codes*/
      font-variant: normal;
      text-transform: none;
     
      /* fix buttons height, for twitter bootstrap */
      line-height: 1em;
     
      /* Animation center compensation - margins should be symmetric */
      /* remove if not needed */
     
      /* You can be more comfortable with increased icons size */
      /* font-size: 120%; */
     
      /* Font smoothing. That was taken from TWBS */
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
     
      /* Uncomment for 3D effect */
      /* text-shadow: 1px 1px 1px rgba(127, 127, 127, 0.3); */
    }
    @font-face {
      font-family: 'fontello';
      src: url('../font/fontello.eot?75751330');
      src: url('../font/fontello.eot?75751330#iefix') format('embedded-opentype'),
           url('../font/fontello.woff?75751330') format('woff'),
           url('../font/fontello.ttf?75751330') format('truetype'),
           url('../font/fontello.svg?75751330#fontello') format('svg');
      font-weight: normal;
      font-style: normal;
    }

.top_menu .icon {
  width: 140px;
  height: 140px;
  margin: auto;
}

